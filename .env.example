# Environment Configuration for Academic AI Compute TUQS (Module 8)
APP_NAME=Academic-AI-Compute-TUQS
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default for zero-friction local execution, PostgreSQL supported)
DATABASE_URL=sqlite:///./tuqs.db

# Quota Policy Settings
DEFAULT_DAILY_TOKEN_LIMIT=100000
SOFT_WARNING_THRESHOLD=0.80

# Fleet Fixture Path
FLEET_FIXTURE_PATH=tests/fixtures/fleet_nodes.json

# Logging and startup migrations (Alembic upgrade head on startup)
LOG_LEVEL=INFO
AUTO_MIGRATE=true
